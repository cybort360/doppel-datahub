DOPPEL_MODE=fixture
DOPPEL_DATA_DIR=data
DOPPEL_ARTIFACT_DIR=artifacts/runs
DOPPEL_TARGET_ENV=NON_PROD
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=
DATAHUB_PLATFORM=file
DATAHUB_ENV=PROD
DATAHUB_SOURCE_DATASET_URNS=urn:li:dataset:(urn:li:dataPlatform:postgres,clinical.patients,PROD);urn:li:dataset:(urn:li:dataPlatform:postgres,clinical.encounters,PROD)

# Optional LLM planner for the DOPPEL agent (any OpenAI-compatible endpoint).
# Leave OPENCODE_API_KEY empty to run the agent with deterministic classification.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-pro
