        {
          "name": "category",
          "dtype": "object",
          "semantic_type": "categorical",
          "nullable": false,
          "tags": [],
          "description": "Order product category.",
          "strategy": "categorical_distribution"
        },
        {
          "name": "status",
          "dtype": "object",
          "semantic_type": "categorical",
          "nullable": false,
          "tags": [],
          "description": "Order fulfillment status.",
          "strategy": "categorical_distribution"
        },
        {
          "name": "payment_method",
          "dtype": "object",
          "semantic_type": "categorical",
          "nullable": false,
          "tags": [],
          "description": "Payment method.",
          "strategy": "categorical_distribution"
        },
        {
          "name": "shipping_country",
          "dtype": "object",
          "semantic_type": "categorical",
          "nullable": false,
          "tags": [],
          "description": "Shipping destination country.",
          "strategy": "categorical_distribution"
        }
      ]
    }
  ]
}
